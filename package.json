{
    "name": "multi-clasp2",
    "version": "5.0.0",
    "description": "Google Clasp wrapper to push changes to multiple Apps Script projects at once.",
    "type": "module",
    "exports": "./build/index.js",
    "main": "build/index.js",
    "author": "Fabrizio Antonangeli",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "lint": "oxlint .",
        "release": "release-it --verbose",
        "build": "tsc",
        "build-watch": "tsc --watch",
        "start": "node build/index.js"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/fantonangeli/multi-clasp2.git"
    },
    "keywords": [
        "clasp",
        "apps",
        "script",
        "multiple",
        "projects"
    ],
    "bugs": {
        "url": "https://github.com/fantonangeli/multi-clasp2/issues"
    },
    "homepage": "https://github.com/fantonangeli/multi-clasp2",
    "bin": {
        "multi-clasp": "build/index.js"
    },
    "files": [
        "build"
    ],
    "dependencies": {
        "@google/clasp": "3.4.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "commander": "^15.0.0",
        "typescript": "npm:@typescript/typescript6@^6.0.3"
    },
    "devDependencies": {
        "@jest/test-sequencer": "^30.4.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.1.2",
        "auto-changelog": "^2.6.0",
        "fs-extra": "^11.4.0",
        "jest": "^30.4.2",
        "oxlint": "^1.77.0",
        "release-it": "^21.0.1",
        "ts-jest": "^29.4.12"
    }
}
